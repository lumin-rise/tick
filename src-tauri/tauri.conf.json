{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TICK",
  "version": "0.1.0",
  "identifier": "com.admin.stocker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TICK",
        "width": 720,
        "height": 680,
        "minWidth": 520,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0e1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
